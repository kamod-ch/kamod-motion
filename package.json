{
  "name": "kamod-motion",
  "version": "0.0.0",
  "private": true,
  "description": "Preact-first animation primitives for Kamod applications, built on Vanilla Motion.",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/kamod-motion.git"
  },
  "type": "module",
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Do not publish the workspace root. Use: pnpm publish:core'); process.exit(1)\"",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @kamod-ch/motion build",
    "docs:dev": "pnpm --filter @kamod-ch/motion-docs dev",
    "dev:docs": "pnpm docs:dev",
    "docs:build": "pnpm build:core && pnpm --filter @kamod-ch/motion-docs build",
    "build:docs": "pnpm docs:build",
    "docs:check": "pnpm --filter @kamod-ch/motion-docs check",
    "check:docs": "pnpm docs:check",
    "docs:preview": "pnpm --filter @kamod-ch/motion-docs preview",
    "preview:docs": "pnpm docs:preview",
    "build:pages": "KAMOD_DOCS_BASE=github-pages pnpm docs:build",
    "typecheck": "pnpm --filter @kamod-ch/motion typecheck && pnpm --filter @kamod-ch/motion build && pnpm -r --filter '!@kamod-ch/motion' typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @kamod-ch/motion-docs test:e2e",
    "test:docs": "pnpm test:e2e",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "qa:publint": "pnpm --filter @kamod-ch/motion publint",
    "qa:attw": "pnpm --filter @kamod-ch/motion attw",
    "qa:package": "pnpm --filter @kamod-ch/motion build && pnpm qa:publint && pnpm qa:attw",
    "qa:size": "pnpm --filter @kamod-ch/motion size",
    "qa:import-graph": "pnpm --filter @kamod-ch/motion qa:import-graph",
    "qa:tarball": "pnpm --filter @kamod-ch/motion qa:tarball",
    "qa:release": "pnpm qa:package && pnpm qa:size && pnpm qa:import-graph && pnpm qa:tarball",
    "pack:core": "pnpm --filter @kamod-ch/motion exec npm pack --dry-run",
    "publish:core": "pnpm --filter @kamod-ch/motion publish --access public",
    "release:check": "pnpm qa:release",
    "release:publish": "pnpm --filter @kamod-ch/motion publish --access public --provenance --no-git-checks",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.17.0"
}
